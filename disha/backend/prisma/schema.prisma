generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USER MODELS
// ==========================================

enum UserRole {
  STUDENT
  CONTRIBUTOR
  MODERATOR
  ADMIN
}

enum AcademicStream {
  SCIENCE
  COMMERCE
  ARTS
  UNDECIDED
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  hashedPassword        String?
  image                 String?
  role                  UserRole  @default(STUDENT)

  // Student-specific fields
  currentClass          String?   // "9", "10", "11", "12"
  stream                AcademicStream?

  // Parental consent
  parentEmail           String?
  parentConsentVerified Boolean   @default(false)
  parentConsentToken    String?   @unique
  parentConsentSentAt   DateTime?

  // Contributor-specific
  contributorInvitedAt  DateTime?
  contributorBio        String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  quizResponses         QuizResponse[]
  recommendations       Recommendation[]
  authoredCareers       Career[]           @relation("CareerAuthor")
  reviewedCareers       Career[]           @relation("CareerReviewer")
  authoredResources     CareerResource[]   @relation("ResourceAuthor")
  submissions           ContentSubmission[] @relation("Submitter")
  reviews               ContentSubmission[] @relation("Reviewer")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CAREER CONTENT MODELS
// ==========================================

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model CareerCluster {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  iconUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careers Career[]

  @@index([slug])
}

model Career {
  id               String          @id @default(cuid())
  clusterId        String
  title            String
  slug             String          @unique
  description      String          @db.Text
  prerequisites    Json            // Array of prerequisite strings
  eligibleStreams  AcademicStream[]
  averageDuration  String?         // e.g., "4-5 years after 12th"
  status           ContentStatus   @default(DRAFT)

  // RIASEC scores for this career (used in matching)
  riasecRealistic     Float @default(0)
  riasecInvestigative Float @default(0)
  riasecArtistic      Float @default(0)
  riasecSocial        Float @default(0)
  riasecEnterprising  Float @default(0)
  riasecConventional  Float @default(0)

  authorId    String?
  reviewerId  String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  cluster         CareerCluster    @relation(fields: [clusterId], references: [id])
  author          User?            @relation("CareerAuthor", fields: [authorId], references: [id])
  reviewer        User?            @relation("CareerReviewer", fields: [reviewerId], references: [id])
  resources       CareerResource[]
  recommendations Recommendation[]

  @@index([slug])
  @@index([clusterId])
  @@index([status])
}

enum ResourceType {
  COURSE
  BOOK
  VIDEO
  ARTICLE
  TOOL
  WEBSITE
}

enum ResourceCost {
  FREE
  PAID
  FREEMIUM
}

model CareerResource {
  id        String        @id @default(cuid())
  careerId  String
  title     String
  url       String
  type      ResourceType
  cost      ResourceCost
  platform  String?       // e.g., "YouTube", "Coursera", "Udemy"
  status    ContentStatus @default(DRAFT)
  authorId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  author User?  @relation("ResourceAuthor", fields: [authorId], references: [id])

  @@index([careerId])
  @@index([status])
}

// ==========================================
// QUIZ & RECOMMENDATION MODELS
// ==========================================

model QuizVersion {
  id        String   @id @default(cuid())
  version   Int      @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  questions QuizQuestion[]
  responses QuizResponse[]

  @@index([isActive])
}

enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  SCALE
}

model QuizQuestion {
  id            String       @id @default(cuid())
  versionId     String
  questionText  String       @db.Text
  questionType  QuestionType
  options       Json         // Array of { label, value } objects
  riasecWeights Json         // Mapping of option values to RIASEC dimension weights
  orderIndex    Int
  createdAt     DateTime     @default(now())

  version QuizVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, orderIndex])
  @@index([versionId])
}

model QuizResponse {
  id          String   @id @default(cuid())
  userId      String
  versionId   String
  responses   Json     // Array of { questionId, selectedValue(s) }
  riasecScore Json?    // Computed RIASEC profile: { R, I, A, S, E, C }
  completedAt DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  version         QuizVersion      @relation(fields: [versionId], references: [id])
  recommendations Recommendation[]

  @@index([userId])
  @@index([versionId])
}

model Recommendation {
  id             String   @id @default(cuid())
  userId         String
  careerId       String
  quizResponseId String
  matchScore     Float    // 0-100 percentage
  reasoning      Json     // Explanation of why this career was recommended
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  career       Career       @relation(fields: [careerId], references: [id])
  quizResponse QuizResponse @relation(fields: [quizResponseId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId, quizResponseId])
  @@index([userId])
  @@index([quizResponseId])
}

// ==========================================
// CONTENT MODERATION MODELS
// ==========================================

enum SubmissionEntityType {
  CAREER
  RESOURCE
}

enum SubmissionAction {
  CREATE
  UPDATE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model ContentSubmission {
  id            String               @id @default(cuid())
  submitterId   String
  reviewerId    String?
  entityType    SubmissionEntityType
  entityId      String?              // Null for CREATE, set for UPDATE
  action        SubmissionAction
  submittedData Json                 // Full data payload
  status        SubmissionStatus     @default(PENDING)
  reviewNotes   String?              @db.Text
  submittedAt   DateTime             @default(now())
  reviewedAt    DateTime?

  submitter User  @relation("Submitter", fields: [submitterId], references: [id])
  reviewer  User? @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([submitterId])
  @@index([status])
  @@index([entityType, status])
}
